# Copy to .env for local development (never commit .env)
DATASK_ENV=development
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Leave MONGODB_URI empty locally to use an in-memory database.
MONGODB_URI=
MONGODB_DB=datask
# AI: set ONE of these keys. With neither (and DATASK_ENV=development) a simple keyword "mock" planner is used.
GEMINI_API_KEY=
GROQ_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
DAILY_ASK_LIMIT=60
